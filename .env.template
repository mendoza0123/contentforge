# ContentForge — Environment Variables
# Copy this file to .env and fill in your values

# OpenAI
OPENAI_API_KEY=sk-...

# Serper.dev (Google search + PAA)
SERPER_API_KEY=...

# Database
DATABASE_URL=sqlite:///contentforge.db

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Optional: fal.ai (for Phase 5 image generation)
# FAL_API_KEY=...

# Optional: n8n (for Phase 4 publishing)
# N8N_BASE_URL=https://n8n-wedh.srv1890748.hstgr.cloud
# N8N_API_KEY=...